mse version: 2.1.2
short name: wsmtools
full name: wsmtools Exporter
position hint: 003
icon: icon.png
version: 2026-05-31
installer group: ronelm2000/weiss2/Export/wsmtools
game: weiss2
create directory: true
file type: Weiss Schwarz Set (*.ws-set)|*.ws-set

depends on:
	package: weiss2.mse-game

# By ronelm2000
# Based on LackeyCCG Export by Pichoro and Innuendo, based on code by Idle Muse and Seeonee

option field:
	type: boolean
	name: export images
	description: Export images? This is required to export to Tabletop Simulator via wsmtools
option field:
	type: text
	name: zoom multiplier
	default: 1.25
	description: Zoom multiplier for the exported images. Use a higher value (e.g. 3) for print-quality images.
option field:
	type: choice
	name: image format
	choice: jpg
	choice: png
	choice: tiff
	choice: bmp
	default: jpg
	description: File format for the exported images. jpg is smallest (lossy); png/tiff/bmp are lossless and better for printing. tiff/bmp support depends on your MSE build.
script:
	zoom_int := to_number(options.zoom_multiplier)
	if options.export_images == "yes" then
	(
		for each card in cards do (
			write_image_file(card, file:"{sanitize_for_filename(card.api_serial)}.{options.image_format}", width: stylesheet.card_width * zoom_int, height: stylesheet.card_height * zoom_int);
		)
	)
	to_string(to_json(cards))
